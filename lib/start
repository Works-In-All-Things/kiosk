#!/usr/bin/env bash
# Works In All Things Kiosk: waits for the address, then starts the cage display server with the session script.
# Older cage versions (before 0.1.5) turn the screen with their own -r option; newer ones are turned by the session
# script with wlr-randr.
set -uo pipefail

URL=""
ROTATION=0
# shellcheck source=/dev/null
[[ -r /etc/kiosk/kiosk.conf ]] && . /etc/kiosk/kiosk.conf

# Waits up to 90 seconds for the address to give a real page, so a TV that powers up with the network gives it
# time to connect, and a server that's starting up or restarting (such as Rock after an app pool recycle, which
# answers with a 5xx error page meanwhile) has time to be ready. Any answer below 500 counts: a page, a redirect,
# or a "not found" that waiting won't fix. It carries on anyway after 90 seconds: a Signage player that was stored
# for offline plays without the network. It logs what it got (see "kiosk logs"). This runs before cage, so the
# start-up screen's logo stays up meanwhile.
wait_for_network() {
    local attempt status=000
    for attempt in $(seq 1 18); do
        status=$(curl --silent --globoff --output /dev/null --max-time 5 --write-out '%{http_code}' "$URL" || true)
        status=${status:-000}
        if [[ $status =~ ^[1-4][0-9][0-9]$ ]]; then
            echo "$URL answered (HTTP $status) after $(((attempt - 1) * 5)) seconds or so."
            return 0
        fi
        [[ $attempt -lt 18 ]] && sleep 5
    done
    if [[ $status == 000 ]]; then
        echo "$URL didn't answer within 90 seconds; starting the browser anyway." >&2
    else
        echo "$URL still answered with an error (HTTP $status) after 90 seconds; starting the browser anyway." >&2
    fi
}

[[ -z $URL ]] || wait_for_network

cage_options=(-s)
if [[ $ROTATION != 0 ]] && cage -h 2>&1 | grep -qE '^[[:space:]]*-r[[:space:]]'; then
    for ((turn = 0; turn < ROTATION / 90; turn++)); do
        cage_options+=(-r)
    done
    export KIOSK_ROTATED_BY_CAGE=yes
fi

# Software drawing: some computers can't give cage graphics acceleration (a VirtualBox VM without 3D acceleration,
# or a graphics chip without a working driver), and then cage can't start at all. When that happened earlier in
# this boot, cage draws in software instead (WLR_RENDERER=pixman): the page shows, though video is less smooth.
# The note holds the boot's ID, so each boot tries acceleration again first.
software_note=${HOME:-/var/lib/kiosk}/software-drawing
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
if [[ -n $boot_id && -r $software_note && $(<"$software_note") == "$boot_id" ]]; then
    export WLR_RENDERER=pixman
    echo "Drawing without graphics acceleration, because the display couldn't start with it. Video may not be smooth. In VirtualBox, turn on 3D acceleration (Settings ▸ Display)." >&2
fi

# cage runs as a child, not in this script's place, so its messages stay with kiosk.service in the log and this
# script can tell why it stopped.
# Its error output is also copied to a file (through tee) to check afterwards; the pipeline ends only when both have.
errors=$(mktemp)
trap 'rm -f "$errors"' EXIT
trap 'exit 143' TERM
{ cage "${cage_options[@]}" -- /usr/local/lib/kiosk/lib/session 2>&1 1>&3 | tee "$errors" >&2; } 3>&1
status=${PIPESTATUS[0]}

if ((status != 0)); then
    if [[ -z ${WLR_RENDERER:-} && -n $boot_id ]] &&
        grep -qE 'Unable to create the wlroots renderer|Could not initialize renderer' "$errors"; then
        printf '%s\n' "$boot_id" >"$software_note"
        echo "The display couldn't start with graphics acceleration; it starts again without it." >&2
    else
        echo "The display stopped (code $status). The messages above say why." >&2
    fi
fi
exit "$status"
