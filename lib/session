#!/usr/bin/env bash
# Works In All Things Kiosk: runs inside the cage display server as the kiosk user. It turns the screen if asked,
# waits briefly for the network, then starts the browser full screen on the configured address. When the browser
# closes, cage closes too and systemd starts them both again.
set -uo pipefail

CONFIG=/etc/kiosk/kiosk.conf
URL=""
ROTATION=0
RESOLUTION=""
BROWSER=""
EXTRA_FLAGS=""
# shellcheck source=/dev/null
[[ -r $CONFIG ]] && . "$CONFIG"

if [[ -z $URL ]]; then
    echo "No address is set. Run: sudo kiosk url <address>" >&2
    exit 1
fi

# The names of the screens, such as HDMI-A-1.
screen_names() {
    wlr-randr 2>/dev/null | awk '/^[^ ]/ { print $1 }'
}

# Waits up to 10 seconds for cage to list the screens. Right after cage starts they may not be listed yet, and
# setting the resolution or rotation then would do nothing.
wait_for_screens() {
    local attempt
    for attempt in $(seq 1 20); do
        [[ -n $(screen_names) ]] && return 0
        sleep 0.5
    done
    echo "No screens were listed after 10 seconds, so the resolution and rotation can't be set." >&2
    return 1
}

# Prints a screen's current mode, such as 1920x1080.
current_mode() {
    wlr-randr 2>/dev/null | awk -v name="$1" '/^[^ ]/ { inside = ($1 == name) } inside && /current/ { print $1; exit }'
}

# Sets every screen to the configured resolution: one the screen offers, or else a custom one (which virtual
# machines accept). Each screen is checked afterwards and tried up to 5 times. Needs wlr-randr and cage 0.2 or later.
set_resolution() {
    [[ -n $RESOLUTION ]] || return 0
    if ! command -v wlr-randr >/dev/null 2>&1; then
        echo "A resolution is set but wlr-randr isn't installed." >&2
        return 0
    fi
    local output attempt
    for output in $(screen_names); do
        for attempt in 1 2 3 4 5; do
            wlr-randr --output "$output" --mode "$RESOLUTION" 2>/dev/null ||
                wlr-randr --output "$output" --custom-mode "$RESOLUTION" 2>/dev/null
            if [[ $(current_mode "$output") == "${RESOLUTION%@*}" ]]; then
                echo "Set $output to $RESOLUTION." >&2
                continue 2
            fi
            sleep 1
        done
        echo "Couldn't set $output to $RESOLUTION (it's $(current_mode "$output")). On a virtual machine, give its display more memory; otherwise this version of cage may not support it." >&2
    done
}

# Turns every screen to the configured rotation. Needs wlr-randr and a cage that supports it (0.2 or later).
rotate_screens() {
    [[ $ROTATION != 0 && ${KIOSK_ROTATED_BY_CAGE:-no} == no ]] || return 0
    if ! command -v wlr-randr >/dev/null 2>&1; then
        echo "Rotation is set but wlr-randr isn't installed." >&2
        return 0
    fi
    local output
    for output in $(screen_names); do
        wlr-randr --output "$output" --transform "$ROTATION" ||
            echo "Couldn't rotate $output. This version of cage may not support rotation." >&2
    done
}

# Waits up to 90 seconds for the address to answer, so a TV that powers up with the network gives it time to
# connect. It starts the browser anyway after that: a Signage player that was stored for offline plays without
# the network.
wait_for_network() {
    local attempt
    for attempt in $(seq 1 18); do
        if curl --silent --globoff --output /dev/null --max-time 5 "$URL"; then
            return 0
        fi
        [[ $attempt -lt 18 ]] && sleep 5
    done
    echo "$URL didn't answer within 90 seconds; starting the browser anyway." >&2
}

# Marks the last browser session as closed normally, so a crash or power cut never shows "Restore pages?".
clear_crash_flag() {
    local preferences=$1/Default/Preferences
    [[ -f $preferences ]] || return 0
    sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/; s/"exited_cleanly":false/"exited_cleanly":true/' \
        "$preferences"
}

# Without wlr-randr, set_resolution and rotate_screens just say it's missing.
if ! command -v wlr-randr >/dev/null 2>&1 || wait_for_screens; then
    set_resolution
    rotate_screens
fi
wait_for_network

# shellcheck disable=SC2054 # The commas separate Chromium feature names, not array items.
flags=(
    --kiosk
    --no-first-run
    --no-default-browser-check
    --noerrdialogs
    --disable-infobars
    --hide-crash-restore-bubble
    --disable-session-crashed-bubble
    --disable-features=Translate,TranslateUI,MediaRouter
    --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL
    --autoplay-policy=no-user-gesture-required
    --check-for-update-interval=31536000
    --password-store=basic
    --overscroll-history-navigation=0
    --disable-pinch
    --ozone-platform=wayland
)
# Browsers only let https:// pages store files for offline play. For an http:// address (such as a test server on
# the local network), Chromium is told to treat just that address as secure, so Signage can still store its slides.
if [[ $URL =~ ^(http://[^/?#]+) ]]; then
    flags+=(--unsafely-treat-insecure-origin-as-secure="${BASH_REMATCH[1]}")
fi
if [[ -n $EXTRA_FLAGS ]]; then
    read -r -a extra <<<"$EXTRA_FLAGS"
    flags+=("${extra[@]}")
fi

if [[ $BROWSER == flatpak ]]; then
    clear_crash_flag "$HOME/.var/app/org.chromium.Chromium/config/chromium"
    exec flatpak run org.chromium.Chromium "${flags[@]}" \
        --user-data-dir="$HOME/.var/app/org.chromium.Chromium/config/chromium" "$URL"
fi

clear_crash_flag "$HOME/chromium"
exec "$BROWSER" "${flags[@]}" --user-data-dir="$HOME/chromium" "$URL"
