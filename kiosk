#!/usr/bin/env bash
# Works In All Things Kiosk: turns a Linux computer into a full-screen player for one web address, such as a
# Signage Player URL. Run "kiosk help" for the commands.
set -euo pipefail

# Admin tools such as useradd live in /usr/sbin, which Debian leaves off the PATH after a plain "su" (without "-").
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
# Put before "kiosk" in the commands messages suggest: "sudo " where sudo is installed. Debian leaves sudo out when a
# root password is set; there, people run the commands as root.
SUDO_HINT="sudo "
command -v sudo >/dev/null 2>&1 || SUDO_HINT=""

KIOSK_REPO=Works-In-All-Things/kiosk
INSTALL_DIR=/usr/local/lib/kiosk
COMMAND_LINK=/usr/local/bin/kiosk
CONFIG_DIR=/etc/kiosk
CONFIG=$CONFIG_DIR/kiosk.conf
STATE=$CONFIG_DIR/install-state
# Where the installed files came from (a release tag or branch, and its commit), so "kiosk update" knows what's newer.
SOURCE_FILE=$CONFIG_DIR/installed-from
KIOSK_USER=kiosk
KIOSK_HOME=/var/lib/kiosk
UNIT_DIR=/etc/systemd/system
FLATPAK_APP=org.chromium.Chromium
# The package manager's own messages go here instead of the screen.
INSTALL_LOG=/var/log/kiosk-install.log
# Present while the screen has been turned on by hand (or by its on time), so it stays on during the off hours.
SCREEN_ON_FLAG=/run/kiosk-screen-on
# The start-up screen: a logo on black while the computer and the browser start. It's the Works In All Things logo
# unless a church sets its own with "kiosk boot logo". Also the Plymouth theme that shows it, the setting that keeps
# it on the screen until the browser replaces it, and what Kiosk changed in the boot settings (so "kiosk boot
# normal" and uninstall take off exactly that).
CUSTOM_LOGO=$CONFIG_DIR/boot-logo.png
BOOT_STATE=$CONFIG_DIR/boot-state
PLYMOUTH_THEME_DIR=/usr/share/plymouth/themes/kiosk
PLYMOUTH_QUIT_DROPIN=$UNIT_DIR/plymouth-quit.service.d/90-kiosk.conf
# Chromium policies Kiosk writes (see write_browser_policy): the distribution's Chromium reads /etc/chromium, and
# Flathub's Chromium reads its own extension folder (Kiosk's whole folder, so uninstall removes it).
NATIVE_POLICY_FILE=/etc/chromium/policies/managed/works-in-all-things-kiosk.json
FLATPAK_POLICY_EXTENSION=/var/lib/flatpak/extension/$FLATPAK_APP.Extension.kiosk
# Remote control over VNC ("kiosk vnc"): wayvnc's settings, password and keys, readable only by root and the kiosk
# user; and the port it listens on.
VNC_DIR=$CONFIG_DIR/vnc
VNC_PORT=5900

SOURCE_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
KIOSK_VERSION=$(cat "$SOURCE_DIR/VERSION" 2>/dev/null || echo unknown)
# shellcheck source=lib/distro.sh
. "$SOURCE_DIR/lib/distro.sh"
# shellcheck source=lib/manage.sh
. "$SOURCE_DIR/lib/manage.sh"

# Messages ----------------------------------------------------------------------------------------------------

# Prints a progress message.
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# Runs a command with its output going to the install log. If it fails, shows the end of the log.
quietly() {
    local status=0
    "$@" >>"$INSTALL_LOG" 2>&1 || status=$?
    ((status == 0)) && return 0
    printf '\n--- The last lines of %s ---\n' "$INSTALL_LOG" >&2
    tail -n 20 "$INSTALL_LOG" >&2
    return "$status"
}

# Prints a warning and carries on.
warn() { printf '\033[1;33mWarning:\033[0m %s\n' "$*" >&2; }

# Prints an error and stops.
die() {
    printf '\033[1;31mError:\033[0m %s\n' "$*" >&2
    exit 1
}

# Questions ---------------------------------------------------------------------------------------------------

# True when questions can be asked: there's a terminal and --yes wasn't given. When installed with
# "curl ... | sudo bash", the script itself arrives on standard input, so questions are read from /dev/tty.
can_ask() { [[ ${ASSUME_YES:-no} == no ]] && { : </dev/tty; } 2>/dev/null; }

# Asks a question and sets ANSWER to the answer, or to the default when the answer is blank or no one is there to
# ask. It sets a variable instead of printing, because reading the terminal inside $(...) hangs under some versions
# of sudo (such as sudo-rs on Ubuntu 25.10 and later) when the installer arrives through a pipe.
ask() {
    local question=$1 default=${2:-}
    ANSWER=""
    if can_ask; then
        if [[ -n $default ]]; then
            read -r -p "$question [$default]: " ANSWER </dev/tty || true
        else
            read -r -p "$question: " ANSWER </dev/tty || true
        fi
    fi
    ANSWER=${ANSWER:-$default}
}

# Asks until the answer passes a check (the name of a function), and leaves it in ANSWER. When no one is there to
# ask, the default must pass, or it stops with the problem.
ask_until() {
    local check=$1 question=$2 default=$3 problem=$4
    while true; do
        ask "$question" "$default"
        "$check" "$ANSWER" && return
        can_ask || die "$problem"
        warn "$problem"
    done
}

# Shows the common time zones and sets ANSWER to the one chosen: a number or name from the list (such as 2 or
# central), or any time zone name (such as Europe/London). Enter keeps the current one.
choose_timezone() {
    local current
    current=$(timedatectl show --property=Timezone --value 2>/dev/null || true)
    current=${current:-UTC}
    if can_ask; then
        printf '\nTime zone (the screen times and the nightly restart use it). It is now %s.\n' "$current"
        printf '  %s\n' "1) Eastern    America/New_York" "2) Central    America/Chicago" \
            "3) Mountain   America/Denver" "4) Arizona    America/Phoenix" "5) Pacific    America/Los_Angeles" \
            "6) Alaska     America/Anchorage" "7) Hawaii     Pacific/Honolulu" \
            "Or type another, such as Europe/London (see them all with: timedatectl list-timezones)."
    fi
    while true; do
        ask "Time zone (a number, or a name)" "$current"
        ANSWER=$(timezone_name "$ANSWER")
        is_timezone "$ANSWER" && return
        can_ask || die "Unknown time zone: $ANSWER"
        warn "Unknown time zone: $ANSWER. Choose a number from the list, or type a name such as America/Chicago."
    done
}

# Turns a choice from the time zone list (a number or a name such as "central") into the time zone's full name.
# Anything else is passed through unchanged.
timezone_name() {
    case ${1,,} in
        1 | eastern) echo America/New_York ;;
        2 | central) echo America/Chicago ;;
        3 | mountain) echo America/Denver ;;
        4 | arizona) echo America/Phoenix ;;
        5 | pacific) echo America/Los_Angeles ;;
        6 | alaska) echo America/Anchorage ;;
        7 | hawaii) echo Pacific/Honolulu ;;
        *) echo "$1" ;;
    esac
}

# Asks a yes/no question. The default is used when no one is there to ask.
confirm() {
    ask "$1 (y/n)" "${2:-y}"
    [[ $ANSWER =~ ^[Yy] ]]
}

# Settings ----------------------------------------------------------------------------------------------------

# Prints a setting from kiosk.conf.
get_setting() {
    [[ -r $CONFIG ]] || return 0
    (
        # shellcheck source=/dev/null
        . "$CONFIG"
        printf '%s' "${!1:-}"
    )
}

# Saves a setting in kiosk.conf, quoted so any address is stored safely.
set_setting() {
    local key=$1 value=$2 line
    line="$key=$(printf '%q' "$value")"
    mkdir -p "$CONFIG_DIR"
    touch "$CONFIG"
    if grep -q "^$key=" "$CONFIG"; then
        KIOSK_LINE=$line awk -v key="$key" 'index($0, key "=") == 1 { print ENVIRON["KIOSK_LINE"]; next } { print }' \
            "$CONFIG" >"$CONFIG.new"
        mv "$CONFIG.new" "$CONFIG"
    else
        printf '%s\n' "$line" >>"$CONFIG"
    fi
    chmod 644 "$CONFIG"
}

# Writes kiosk.conf with its comments, the first time Kiosk is installed.
write_default_config() {
    [[ -e $CONFIG ]] && return 0
    mkdir -p "$CONFIG_DIR"
    cat >"$CONFIG" <<'EOF'
# Works In All Things Kiosk settings. Change them with the kiosk command (run "kiosk help"), or edit this file
# and run "sudo kiosk restart".

# The address to show full screen, such as a Signage Player URL.
URL=''

# Screen rotation: 0, 90, 180 or 270 (needs cage 0.2 or later).
ROTATION=0

# Screen resolution, such as 1920x1080 (or 1920x1080@60), or blank for the screen's own best (needs cage 0.2 or
# later).
RESOLUTION=''

# Turn the screen off and on at these times each day (24-hour HH:MM), or leave both blank to keep it on.
SCREEN_OFF=''
SCREEN_ON=''

# Restart the computer at this time each day (24-hour HH:MM), or leave blank for never.
RESTART_TIME=03:30

# Hide the start-up text (yes or no): the logo on black until the page appears. Change it with "kiosk boot quiet"
# or "kiosk boot normal", and the logo with "kiosk boot logo", not here.
QUIET_BOOT=yes

# Remote control over VNC: off, on (from the network) or ssh-only (through an SSH tunnel), and whether the Mac's
# Screen Sharing may connect from the network (yes or no). Change them with "kiosk vnc", not here.
VNC=off
VNC_ALLOW_MAC=no

# The browser: flatpak, or the path of the distribution's Chromium. Set by the installer.
BROWSER=''

# Extra Chromium command-line options, separated by spaces.
EXTRA_FLAGS=''
EOF
    chmod 644 "$CONFIG"
}

# Checks a 24-hour time like 22:00.
is_time() { [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }

# Checks a time zone name, such as America/Chicago.
is_timezone() { [[ -n $1 && $1 != *..* && -f /usr/share/zoneinfo/$1 ]]; }

# Checks a screen resolution, such as 1920x1080 or 1920x1080@60.
is_resolution() { [[ $1 =~ ^[0-9]{3,5}x[0-9]{3,5}(@[0-9]+(\.[0-9]+)?)?$ ]]; }

# Checks a screen rotation.
is_rotation() { [[ $1 =~ ^(0|90|180|270)$ ]]; }

# Checks a 24-hour time, or blank.
is_time_or_blank() { [[ -z $1 ]] || is_time "$1"; }

# Checks a 24-hour time, or "off" (or blank) for none.
is_time_or_off() { [[ -z $1 || $1 == off ]] || is_time "$1"; }

# Checks yes or no.
is_yes_no() { [[ $1 =~ ^(yes|no)$ ]]; }

# Checks a web address.
is_url() { [[ $1 =~ ^https?://[^[:space:]]+$ ]]; }

# Minutes since midnight for a 24-hour time.
minutes_of() { echo $((10#${1%%:*} * 60 + 10#${1##*:})); }

# Install state ----------------------------------------------------------------------------------------------

# Remembers something about the computer before Kiosk changed it, so uninstall can put it back.
remember() {
    mkdir -p "$CONFIG_DIR"
    grep -q "^$1=" "$STATE" 2>/dev/null && return 0
    printf '%s=%q\n' "$1" "$2" >>"$STATE"
}

# Prints something remembered by remember().
recall() {
    [[ -r $STATE ]] || return 0
    (
        # shellcheck source=/dev/null
        . "$STATE"
        printf '%s' "${!1:-}"
    )
}

# Checks ------------------------------------------------------------------------------------------------------

# Stops unless running as root. Without sudo (Debian leaves it out when a root password is set), says to use su.
require_root() {
    [[ $EUID -eq 0 ]] && return
    command -v sudo >/dev/null 2>&1 || die "Run this as root: su -   then: kiosk $*"
    die "Run this with sudo: sudo kiosk $*"
}

# Stops unless Kiosk is installed.
require_installed() {
    [[ -e $UNIT_DIR/kiosk.service ]] || die "Kiosk isn't installed. Install it with: ${SUDO_HINT}kiosk install"
}

# Stops on computers Kiosk can't run on.
check_system() {
    [[ -d /run/systemd/system ]] || die "Kiosk needs systemd, and this computer doesn't use it."
    [[ ! -e /run/ostree-booted ]] ||
        die "This is an image-based system (such as Fedora Silverblue). Kiosk needs a normal installation."
    case $(uname -m) in
        x86_64 | aarch64) ;;
        *) die "Kiosk needs a 64-bit Intel/AMD or ARM computer (this one is $(uname -m))." ;;
    esac
    detect_distro
}

# Install -----------------------------------------------------------------------------------------------------

# Installs Kiosk, or with --update, updates its files and keeps the settings.
cmd_install() {
    local -a packages
    local url="" rotation="" resolution="" resolution_set=no timezone="" screen_off="" screen_on="" restart_time="" browser=auto
    local update=no screen_set=no restart_set=no reboot=no manage_address="" manage_code="" allow_http=no
    local source_ref="" source_commit="" quiet_boot=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --url) url=${2:-}; shift 2 ;;
            --rotation) rotation=${2:-}; shift 2 ;;
            --resolution) resolution=${2:-}; resolution_set=yes; shift 2 ;;
            --timezone) timezone=${2:-}; shift 2 ;;
            --screen-off) screen_off=${2:-}; screen_set=yes; shift 2 ;;
            --screen-on) screen_on=${2:-}; screen_set=yes; shift 2 ;;
            --restart-time) restart_time=${2:-}; restart_set=yes; shift 2 ;;
            --browser) browser=${2:-}; shift 2 ;;
            --quiet-boot) quiet_boot=${2:-}; shift 2 ;;
            --yes | -y) ASSUME_YES=yes; shift ;;
            --update) update=yes; ASSUME_YES=yes; shift ;;
            --reboot) reboot=yes; shift ;;
            --manage) manage_address=${2:-}; shift 2 ;;
            --code) manage_code=${2:-}; shift 2 ;;
            --allow-http) allow_http=yes; shift ;;
            # Passed by install.sh and "kiosk update": where these files came from.
            --source) source_ref=${2:-}; shift 2 ;;
            --commit) source_commit=${2:-}; shift 2 ;;
            *) die "Unknown option: $1 (see: kiosk help)" ;;
        esac
    done
    require_root install
    check_system
    [[ -z $quiet_boot ]] || is_yes_no "$quiet_boot" || die "--quiet-boot must be yes or no."

    if [[ $update == yes ]]; then
        require_installed
        info "Updating Kiosk to $KIOSK_VERSION on $DISTRO_NAME"
        install_files
        save_source "$source_ref" "$source_commit"
        enable_units
        apply_boot
        systemctl restart kiosk.service || true
        info "Kiosk is updated to $KIOSK_VERSION."
        return
    fi

    printf '\n\033[1mWorks In All Things Kiosk %s\033[0m on %s\n\n' "$KIOSK_VERSION" "$DISTRO_NAME"
    if [[ -n $manage_address || -n $manage_code ]]; then
        [[ -n $manage_address && -n $manage_code ]] || die "Use --manage <rock address> --code <code> together (both are on the kiosk's page in Rock)."
        install_managed "$manage_address" "$manage_code" "$allow_http" "$browser" "$reboot" "$source_ref" "$source_commit" \
            "$quiet_boot"
        return
    fi
    refuse_if_managed settings
    [[ -n $(get_setting URL) ]] && info "Kiosk is already installed. Your settings are kept unless you change them."

    # Questions first, so the rest runs without stopping. A wrong answer is asked again.
    url=${url:-$(get_setting URL)}
    if ! is_url "$url"; then
        ask_until is_url "The address to show (the Player URL)" "" "The address must start with https:// or http://."
        url=$ANSWER
    fi
    if [[ $url == http://* ]]; then
        info "This is an http:// address. Kiosk tells the browser to treat it as secure, so Signage can still store slides for offline play."
    fi

    if [[ -z $timezone ]]; then
        choose_timezone
        timezone=$ANSWER
    else
        timezone=$(timezone_name "$timezone")
        is_timezone "$timezone" || die "Unknown time zone: $timezone (for example America/Chicago, or central)."
    fi

    if [[ -z $rotation ]]; then
        rotation=$(get_setting ROTATION)
        ask_until is_rotation "Screen rotation: 0, 90, 180 or 270" "${rotation:-0}" "Rotation must be 0, 90, 180 or 270."
        rotation=$ANSWER
    fi
    is_rotation "$rotation" || die "Rotation must be 0, 90, 180 or 270."
    [[ $resolution == auto ]] && resolution=""
    [[ -z $resolution ]] || is_resolution "$resolution" || die "The resolution must look like 1920x1080, or auto."

    if [[ $screen_set == no ]]; then
        ask_until is_time_or_blank "Turn the screen off each day at (24-hour, like 22:00; blank keeps it on)" \
            "$(get_setting SCREEN_OFF)" "Use a 24-hour time like 22:00, or leave it blank."
        screen_off=$ANSWER
        screen_on=""
        if [[ -n $screen_off ]]; then
            ask_until is_time "Turn the screen on each day at (24-hour, like 06:30)" "$(get_setting SCREEN_ON)" \
                "Use a 24-hour time like 06:30."
            screen_on=$ANSWER
        fi
    fi
    if [[ -n $screen_off || -n $screen_on ]]; then
        if ! is_time "$screen_off" || ! is_time "$screen_on"; then
            die "Screen off and on times must both be 24-hour times like 22:00 and 06:00."
        fi
    fi

    if [[ $restart_set == no ]]; then
        local default_restart
        default_restart=$(get_setting RESTART_TIME)
        [[ -e $CONFIG ]] || default_restart=03:30
        ask_until is_time_or_off "Restart the computer each day at (24-hour, like 03:30, or 'off')" \
            "${default_restart:-off}" "Use a 24-hour time like 03:30, or 'off'."
        restart_time=$ANSWER
    fi
    is_time_or_off "$restart_time" || die "The restart time must be a 24-hour time like 03:30, or 'off'."
    [[ $restart_time == off ]] && restart_time=""

    if [[ -z $quiet_boot ]]; then
        local default_quiet=y
        [[ $(get_setting QUIET_BOOT) == no ]] && default_quiet=n
        if confirm "Hide the start-up text (a logo on black until the page appears)?" "$default_quiet"; then
            quiet_boot=yes
        else
            quiet_boot=no
        fi
    fi

    local display_manager=""
    if [[ -L $UNIT_DIR/display-manager.service ]]; then
        display_manager=$(readlink -f "$UNIT_DIR/display-manager.service")
        display_manager=${display_manager##*/}
    fi
    if [[ -n $display_manager && $display_manager != kiosk.service ]]; then
        confirm "This computer starts a desktop ($display_manager). Turn it off so the kiosk can use the screen?" y ||
            die "Kiosk needs the screen. Nothing was changed."
    fi

    info "Installing packages. This takes a few minutes; the details go to $INSTALL_LOG."
    : >"$INSTALL_LOG"
    quietly pkg_refresh || die "Couldn't refresh the package lists. Check the network and run the installer again."
    KIOSK_LISTS_REFRESHED=yes
    mapfile -t packages < <(required_packages)
    pkg_install "${packages[@]}"
    mapfile -t packages < <(optional_packages)
    pkg_install_optional "${packages[@]}"
    install_browser "$browser"
    enable_automatic_updates

    info "Setting up the kiosk"
    timedatectl set-timezone "$timezone"
    timedatectl set-ntp true 2>/dev/null || true
    create_user
    install_files
    save_source "$source_ref" "$source_commit"
    write_default_config
    set_setting URL "$url"
    set_setting ROTATION "$rotation"
    [[ $resolution_set == no ]] || set_setting RESOLUTION "$resolution"
    set_setting SCREEN_OFF "$screen_off"
    set_setting SCREEN_ON "$screen_on"
    set_setting RESTART_TIME "$restart_time"
    set_setting BROWSER "$KIOSK_BROWSER"
    set_setting QUIET_BOOT "$quiet_boot"

    if [[ -n $display_manager && $display_manager != kiosk.service ]]; then
        remember DISPLAY_MANAGER "$display_manager"
        systemctl disable "$display_manager" >/dev/null 2>&1 || true
    fi
    remember GETTY_TTY1 "$(systemctl is-enabled getty@tty1.service 2>/dev/null || echo enabled)"
    enable_units
    apply_boot

    printf '\n\033[1mKiosk is installed.\033[0m It shows %s full screen whenever this computer starts.\n' "$url"
    echo "Change it later with: ${SUDO_HINT}kiosk url <address>   (more: kiosk help)"
    if [[ $reboot == yes ]] || { can_ask && confirm "Restart now to start it?" y; }; then
        systemctl reboot
    else
        echo "Restart the computer to start it."
    fi
}

# Installs Kiosk managed by Rock ("kiosk install --manage <rock address> --code <code>"). There are no questions:
# the computer is linked to its kiosk in Rock first thing after the packages are installed, and Rock's settings
# (the address, time zone, rotation, screen and restart times) are used.
install_managed() {
    local address=$1 code=$2 allow_http=$3 browser=$4 reboot=$5 source_ref=$6 source_commit=$7 quiet_boot=${8:-}
    local display_manager="" url
    [[ $address == http://* && $allow_http != yes ]] &&
        die "The Rock address is http://, so this computer's token would cross the network unencrypted. Use https://, or add --allow-http (for a test server)."
    if [[ -L $UNIT_DIR/display-manager.service ]]; then
        display_manager=$(readlink -f "$UNIT_DIR/display-manager.service")
        display_manager=${display_manager##*/}
    fi
    if [[ -n $display_manager && $display_manager != kiosk.service ]]; then
        confirm "This computer starts a desktop ($display_manager). Turn it off so the kiosk can use the screen?" y ||
            die "Kiosk needs the screen. Nothing was changed."
    fi

    info "Installing packages. This takes a few minutes; the details go to $INSTALL_LOG."
    : >"$INSTALL_LOG"
    quietly pkg_refresh || die "Couldn't refresh the package lists. Check the network and run the installer again."
    KIOSK_LISTS_REFRESHED=yes
    local -a packages
    mapfile -t packages < <(required_packages)
    pkg_install "${packages[@]}"
    mapfile -t packages < <(optional_packages)
    pkg_install_optional "${packages[@]}"
    install_browser "$browser"
    enable_automatic_updates

    info "Setting up the kiosk"
    timedatectl set-ntp true 2>/dev/null || true
    create_user
    install_files
    save_source "$source_ref" "$source_commit"
    write_default_config
    set_setting BROWSER "$KIOSK_BROWSER"
    # No questions here: the start-up text is hidden unless --quiet-boot no was given.
    [[ -n $quiet_boot ]] || quiet_boot=$(get_setting QUIET_BOOT)
    set_setting QUIET_BOOT "${quiet_boot:-yes}"
    manage_enroll "$address" "$code" "$allow_http"
    send_heartbeat no-restart || die "Linked to Rock, but couldn't get the kiosk's settings: $(rock_message). Run: ${SUDO_HINT}kiosk heartbeat"
    url=$(get_setting URL)
    [[ -n $url ]] || die "Rock didn't send an address to show. Set one on the kiosk's page in Rock, then run: ${SUDO_HINT}kiosk heartbeat"

    if [[ -n $display_manager && $display_manager != kiosk.service ]]; then
        remember DISPLAY_MANAGER "$display_manager"
        systemctl disable "$display_manager" >/dev/null 2>&1 || true
    fi
    remember GETTY_TTY1 "$(systemctl is-enabled getty@tty1.service 2>/dev/null || echo enabled)"
    enable_units
    apply_boot

    printf '\n\033[1mKiosk is installed and managed by Rock.\033[0m It shows %s full screen whenever this computer starts.\n' "$url"
    echo "Change its settings on its page in Rock."
    if [[ $reboot == yes ]] || { can_ask && confirm "Restart now to start it?" y; }; then
        systemctl reboot
    else
        echo "Restart the computer to start it."
    fi
}

# Installs the browser: the distribution's Chromium where it has full video support, otherwise Chromium from
# Flathub. Sets KIOSK_BROWSER to "flatpak" or the browser's path.
install_browser() {
    local choice=$1 package
    case $choice in
        auto | native | flatpak) ;;
        *) die "The browser must be auto, native or flatpak." ;;
    esac
    package=""
    [[ $choice == flatpak ]] || package=$(native_chromium_package)
    if [[ $choice == native && -z $package ]]; then
        die "$DISTRO_NAME has no Chromium package with full video support. Use --browser flatpak."
    fi

    if [[ -n $package ]]; then
        pkg_install "$package"
        KIOSK_BROWSER=$(command -v chromium || command -v chromium-browser || true)
        [[ -n $KIOSK_BROWSER ]] || die "Chromium was installed but couldn't be found."
        info "Browser: $package from $DISTRO_NAME"
        return
    fi

    info "Browser: Chromium from Flathub (this distribution's own Chromium can't play every video)"
    pkg_install flatpak
    quietly flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo ||
        die "Couldn't reach Flathub (dl.flathub.org). Check the network and run the installer again."
    info "Downloading Chromium from Flathub (a few hundred MB; this can take several minutes)"
    quietly flatpak install --system --noninteractive -y flathub "$FLATPAK_APP" ||
        die "Couldn't install Chromium from Flathub. Check the network and run the installer again."
    KIOSK_BROWSER=flatpak
}

# Writes Chromium's policy for the kiosk's address: its site may reach devices on the local network without
# Chromium's "wants to access other devices on your local network" question, which nobody can answer on a TV.
# Other sites still get the question. kiosk.service runs this (as root) each time the browser starts, so the
# policy follows the address. It never fails: without the policy the page still loads.
write_browser_policy() {
    local url origin policy_file arch
    url=$(get_setting URL)
    origin=""
    # Only a plain scheme://host[:port], so nothing in the address can break the JSON.
    [[ $url =~ ^(https?://[A-Za-z0-9.:_-]+|https?://\[[0-9A-Fa-f:.]+\](:[0-9]+)?) ]] && origin=${BASH_REMATCH[1]}

    if [[ $(get_setting BROWSER) == flatpak ]]; then
        rm -f "$NATIVE_POLICY_FILE"
        arch=$(flatpak --default-arch 2>/dev/null) || return 0
        policy_file=$FLATPAK_POLICY_EXTENSION/$arch/1/policies/managed/kiosk.json
    else
        rm -rf "$FLATPAK_POLICY_EXTENSION"
        policy_file=$NATIVE_POLICY_FILE
    fi

    if [[ -z $origin ]]; then
        rm -f "$policy_file"
        return 0
    fi
    if ! { mkdir -p "$(dirname "$policy_file")" &&
        printf '{\n  "LocalNetworkAccessAllowedForUrls": ["%s"]\n}\n' "$origin" >"$policy_file.new" &&
        chmod 644 "$policy_file.new" &&
        mv "$policy_file.new" "$policy_file"; }; then
        warn "Couldn't write the browser policy ($policy_file)."
    fi
}

# Removes the browser policy Kiosk wrote.
remove_browser_policy() {
    rm -rf "$FLATPAK_POLICY_EXTENSION"
    rm -f "$NATIVE_POLICY_FILE"
}

# Makes the kiosk user that the browser runs as. It has no password and can't log in.
create_user() {
    if ! id "$KIOSK_USER" >/dev/null 2>&1; then
        local nologin
        nologin=$(command -v nologin || echo /usr/sbin/nologin)
        useradd --system --create-home --home-dir "$KIOSK_HOME" --shell "$nologin" \
            --comment "Kiosk display" "$KIOSK_USER"
    fi
    local group
    for group in video render audio input; do
        getent group "$group" >/dev/null && usermod -a -G "$group" "$KIOSK_USER"
    done
    chmod 700 "$KIOSK_HOME"
}

# Copies Kiosk's own files into place: the command, the session script, the systemd units and the login
# session settings.
install_files() {
    if [[ $SOURCE_DIR != "$INSTALL_DIR" ]]; then
        rm -rf "$INSTALL_DIR.new"
        mkdir -p "$INSTALL_DIR.new"
        cp -R "$SOURCE_DIR/kiosk" "$SOURCE_DIR/VERSION" "$SOURCE_DIR/lib" "$SOURCE_DIR/systemd" "$INSTALL_DIR.new/"
        rm -rf "$INSTALL_DIR"
        mv "$INSTALL_DIR.new" "$INSTALL_DIR"
    fi
    chmod 755 "$INSTALL_DIR/kiosk" "$INSTALL_DIR/lib/session" "$INSTALL_DIR/lib/start"
    # On SELinux systems such as Fedora, systemd may only run files labelled as programs.
    if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
        chcon -t bin_t "$INSTALL_DIR/kiosk" "$INSTALL_DIR/lib/session" "$INSTALL_DIR/lib/start" ||
            warn "Couldn't label Kiosk's programs for SELinux."
    fi
    ln -sf "$INSTALL_DIR/kiosk" "$COMMAND_LINK"
    install -m 644 "$INSTALL_DIR/lib/pam-kiosk" /etc/pam.d/kiosk
    local unit
    for unit in "$INSTALL_DIR"/systemd/*; do
        install -m 644 "$unit" "$UNIT_DIR/"
    done
}

# Turns on the kiosk and its timers, and turns off the console login on the first screen.
enable_units() {
    write_timers
    systemctl daemon-reload
    systemctl disable getty@tty1.service >/dev/null 2>&1 || true
    systemctl enable kiosk.service kiosk-update.timer >/dev/null
    if is_managed; then
        systemctl enable kiosk-heartbeat.timer >/dev/null
    fi
}

# Writes the screen and restart timers from the settings, and turns each on or off.
write_timers() {
    local screen_off screen_on restart_time
    screen_off=$(get_setting SCREEN_OFF)
    screen_on=$(get_setting SCREEN_ON)
    restart_time=$(get_setting RESTART_TIME)
    write_timer kiosk-screen-off "Turn the kiosk screen off" "$screen_off"
    write_timer kiosk-screen-on "Turn the kiosk screen on" "$screen_on"
    write_timer kiosk-reboot "Restart the kiosk computer" "$restart_time"
}

# Writes one daily timer and turns it on, or removes it when the time is blank.
write_timer() {
    local name=$1 description=$2 time=$3
    if [[ -z $time ]]; then
        systemctl disable --now "$name.timer" >/dev/null 2>&1 || true
        rm -f "$UNIT_DIR/$name.timer"
        return
    fi
    cat >"$UNIT_DIR/$name.timer" <<EOF
# Works In All Things Kiosk: written by "kiosk"; change the time with the kiosk command, not here.
[Unit]
Description=$description at $time

[Timer]
OnCalendar=*-*-* $time:00

[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload
    systemctl enable "$name.timer" >/dev/null 2>&1
    systemctl restart "$name.timer" >/dev/null 2>&1 || true
}

# Settings commands -------------------------------------------------------------------------------------------

# Shows the address, or sets a new one and restarts the browser.
cmd_url() {
    if [[ $# -eq 0 ]]; then
        get_setting URL
        echo
        return
    fi
    require_root url
    require_installed
    refuse_if_managed address
    is_url "$1" || die "The address must start with https:// or http://."
    set_setting URL "$1"
    systemctl restart kiosk.service
    info "Now showing $1"
}

# Sets the screen rotation.
cmd_rotate() {
    require_root rotate
    require_installed
    refuse_if_managed rotation
    [[ ${1:-} =~ ^(0|90|180|270)$ ]] || die "Use: kiosk rotate 0|90|180|270"
    set_setting ROTATION "$1"
    systemctl restart kiosk.service
    info "Rotation set to $1."
}

# Sets the screen resolution, or "auto" for the screen's own best.
cmd_resolution() {
    require_root resolution
    require_installed
    refuse_if_managed resolution
    local resolution=${1:-}
    [[ -n $resolution ]] || die "Use: kiosk resolution 1920x1080|auto"
    [[ $resolution == auto ]] && resolution=""
    [[ -z $resolution ]] || is_resolution "$resolution" || die "Use: kiosk resolution 1920x1080|auto"
    set_setting RESOLUTION "$resolution"
    systemctl restart kiosk.service
    if [[ -n $resolution ]]; then
        info "Resolution: $resolution."
    else
        info "Resolution: auto (the screen's own best)."
    fi
}

# Sets the nightly restart time, or turns it off.
cmd_restart_time() {
    require_root restart-time
    require_installed
    refuse_if_managed "restart time"
    local time=${1:-}
    [[ $time == off ]] && time=""
    [[ -z $time ]] || is_time "$time" || die "Use: kiosk restart-time HH:MM|off"
    [[ -n ${1:-} ]] || die "Use: kiosk restart-time HH:MM|off"
    set_setting RESTART_TIME "$time"
    write_timers
    info "Nightly restart: ${time:-off}."
}

# Restarts the browser.
cmd_restart() {
    require_root restart
    require_installed
    systemctl restart kiosk.service
    info "The browser is restarting."
}

# Screen ------------------------------------------------------------------------------------------------------

# Turns the screen off or on now, sets its daily schedule, or (for the kiosk service) checks whether it should
# be on right now.
cmd_screen() {
    case ${1:-} in
        off)
            require_root screen
            rm -f "$SCREEN_ON_FLAG"
            touch "$SCREEN_OFF_FLAG"
            systemctl stop kiosk.service
            blank_screen 4
            info "The screen is off. Turn it on with: ${SUDO_HINT}kiosk screen on"
            ;;
        on)
            require_root screen
            touch "$SCREEN_ON_FLAG"
            rm -f "$SCREEN_OFF_FLAG"
            blank_screen 0
            systemctl start kiosk.service
            info "The screen is on."
            ;;
        schedule)
            require_root screen
            require_installed
            refuse_if_managed "screen times"
            if [[ ${2:-} == off ]]; then
                set_setting SCREEN_OFF ""
                set_setting SCREEN_ON ""
            else
                if ! is_time "${2:-}" || ! is_time "${3:-}"; then
                    die "Use: kiosk screen schedule HH:MM HH:MM (off, then on), or: kiosk screen schedule off"
                fi
                set_setting SCREEN_OFF "$2"
                set_setting SCREEN_ON "$3"
            fi
            write_timers
            info "Screen schedule: $(screen_schedule_text)."
            ;;
        check)
            # Used by kiosk.service: fails (so the browser doesn't start) during the off hours.
            if screen_should_be_off; then
                blank_screen 4
                exit 1
            fi
            ;;
        *) die "Use: kiosk screen off|on|schedule" ;;
    esac
}

# Blanks (4) or unblanks (0) the console, which also tells most screens to go to sleep or wake up.
blank_screen() {
    local blank
    for blank in /sys/class/graphics/fb*/blank; do
        if [[ -w $blank ]]; then
            echo "$1" >"$blank" 2>/dev/null || true
        fi
    done
}

# True during the screen's off hours, unless it was turned on since the last off time.
screen_should_be_off() {
    local screen_off screen_on now off on
    [[ ! -e $SCREEN_ON_FLAG ]] || return 1
    screen_off=$(get_setting SCREEN_OFF)
    screen_on=$(get_setting SCREEN_ON)
    if ! is_time "$screen_off" || ! is_time "$screen_on"; then
        return 1
    fi
    now=$(minutes_of "$(date +%H:%M)")
    off=$(minutes_of "$screen_off")
    on=$(minutes_of "$screen_on")
    if ((off < on)); then
        ((now >= off && now < on))
    else
        ((now >= off || now < on))
    fi
}

# Describes the screen schedule.
screen_schedule_text() {
    local screen_off screen_on
    screen_off=$(get_setting SCREEN_OFF)
    screen_on=$(get_setting SCREEN_ON)
    if [[ -n $screen_off ]]; then
        echo "off at $screen_off, on at $screen_on"
    else
        echo "always on"
    fi
}

# Start-up screen ---------------------------------------------------------------------------------------------

# Prints a value Kiosk keeps about the boot settings it changed.
boot_state() { CONFIG=$BOOT_STATE get_setting "$1"; }

# Saves a value about the boot settings Kiosk changed, so they can be taken off again.
set_boot_state() { CONFIG=$BOOT_STATE set_setting "$1" "$2"; }

# Hides or shows the start-up text to match the QUIET_BOOT setting. Changes only what isn't right yet, so it's safe
# to run again (the installer and "kiosk update" do).
apply_boot() {
    if [[ $(get_setting QUIET_BOOT) == yes ]]; then
        boot_quiet_on
    else
        boot_quiet_off
    fi
}

# Hides the start-up text: kernel options and a hidden boot menu, and the start-up screen (black, or the logo).
boot_quiet_on() {
    local method
    method=$(boot_method)
    if [[ -z $method ]]; then
        warn "Kiosk can't hide the start-up text on this computer yet: it doesn't know its boot loader. It starts as before."
        return 0
    fi
    info "Hiding the start-up text"
    set_boot_state METHOD "$method"
    install_boot_theme
    boot_args_add "$method"
}

# Shows the start-up text again: takes off what boot_quiet_on added. Does nothing if Kiosk never changed it.
boot_quiet_off() {
    local method
    method=$(boot_state METHOD)
    [[ -n $method ]] || return 0
    info "Showing the start-up text again"
    boot_args_remove "$method"
    remove_boot_theme
    set_boot_state METHOD ""
}

# True when the computer asks for a disk password at start-up. Kiosk's start-up screen can't show that question,
# so it's left to the distribution's own.
has_encrypted_disk() { grep -qsvE '^[[:space:]]*(#|$)' /etc/crypttab; }

# Prints the logo shown at start-up: the church's own, or the Works In All Things logo.
logo_file() {
    if [[ -f $CUSTOM_LOGO ]]; then
        printf '%s' "$CUSTOM_LOGO"
    else
        printf '%s' "$INSTALL_DIR/lib/plymouth/logo.png"
    fi
}

# Puts Kiosk's start-up screen in place: Plymouth with Kiosk's theme and the logo, left on the screen until the
# browser replaces it. Rebuilds the start-up image only when something changed.
install_boot_theme() {
    local -a packages
    local changed=no file
    mapfile -t packages < <(plymouth_packages)
    if [[ ${#packages[@]} -eq 0 ]]; then
        warn "Kiosk can't show a start-up screen on $DISTRO_NAME yet, so the screen stays black with a cursor."
        return 0
    fi
    if has_encrypted_disk; then
        warn "This computer asks for a disk password at start-up, so its own start-up screen is kept."
        return 0
    fi
    if ! command -v plymouthd >/dev/null 2>&1; then
        [[ ${KIOSK_LISTS_REFRESHED:-no} == yes ]] || quietly pkg_refresh || true
        pkg_install_optional "${packages[@]}"
        command -v plymouthd >/dev/null 2>&1 || { warn "Couldn't install Plymouth, so there's no start-up screen."; return 0; }
        changed=yes
    fi
    # Some distributions package Plymouth's script module with the themes.
    if ! plymouth_has_script_module && [[ $DISTRO_FAMILY == apt ]]; then
        pkg_install_optional plymouth-themes
    fi
    if ! plymouth_has_script_module; then
        warn "Plymouth's script module isn't installed, so the distribution's own start-up screen is kept."
        return 0
    fi

    mkdir -p "$PLYMOUTH_THEME_DIR"
    for file in kiosk.plymouth kiosk.script; do
        if ! cmp -s "$INSTALL_DIR/lib/plymouth/$file" "$PLYMOUTH_THEME_DIR/$file"; then
            install -m 644 "$INSTALL_DIR/lib/plymouth/$file" "$PLYMOUTH_THEME_DIR/$file"
            changed=yes
        fi
    done
    if ! cmp -s "$(logo_file)" "$PLYMOUTH_THEME_DIR/logo.png"; then
        install -m 644 "$(logo_file)" "$PLYMOUTH_THEME_DIR/logo.png"
        changed=yes
    fi
    keep_splash_on_quit

    if [[ $(plymouth_current_theme) != kiosk ]]; then
        [[ $(boot_state THEME) == yes ]] || set_boot_state THEME_BEFORE "$(plymouth_current_theme)"
        plymouth_use_kiosk_theme "$PLYMOUTH_THEME_DIR"
        changed=yes
    fi
    set_boot_state THEME yes
    if [[ $changed == yes ]]; then
        info "Updating the start-up image (this can take a minute)"
        quietly rebuild_initramfs || warn "Couldn't rebuild the start-up image, so the new start-up screen may not show yet."
    fi
}

# Leaves the start-up screen's last picture (the logo) on the screen when Plymouth ends, until the kiosk's browser
# replaces it, instead of a black screen in between.
keep_splash_on_quit() {
    local plymouth content
    plymouth=$(command -v plymouth || echo /usr/bin/plymouth)
    content=$(printf '%s\n' "# Works In All Things Kiosk: leave the start-up logo up until the kiosk's browser replaces it." \
        "[Service]" "ExecStart=" "ExecStart=-$plymouth quit --retain-splash")
    if [[ ! -f $PLYMOUTH_QUIT_DROPIN || $(cat "$PLYMOUTH_QUIT_DROPIN") != "$content" ]]; then
        mkdir -p "${PLYMOUTH_QUIT_DROPIN%/*}"
        printf '%s\n' "$content" >"$PLYMOUTH_QUIT_DROPIN"
        systemctl daemon-reload
    fi
}

# Takes Kiosk's start-up screen off, and puts back the one that was there before.
remove_boot_theme() {
    [[ $(boot_state THEME) == yes ]] || return 0
    plymouth_restore_theme "$(boot_state THEME_BEFORE)" "$PLYMOUTH_THEME_DIR"
    rm -rf "$PLYMOUTH_THEME_DIR"
    if [[ -f $PLYMOUTH_QUIT_DROPIN ]]; then
        rm -f "$PLYMOUTH_QUIT_DROPIN"
        rmdir "${PLYMOUTH_QUIT_DROPIN%/*}" 2>/dev/null || true
        systemctl daemon-reload
    fi
    set_boot_state THEME ""
    info "Updating the start-up image (this can take a minute)"
    quietly rebuild_initramfs || warn "Couldn't rebuild the start-up image."
}

# Saves the logo for the start-up screen: a PNG file, or an https:// address to download one from.
set_boot_logo() {
    local source=$1 file
    file=$(mktemp)
    if [[ $source =~ ^https?:// ]]; then
        curl -fsSL --proto '=https,http' --max-time 60 --max-filesize 10485760 -o "$file" "$source" ||
            { rm -f "$file"; die "Couldn't download the logo from $source."; }
    else
        [[ -f $source ]] || { rm -f "$file"; die "There's no file $source."; }
        cp "$source" "$file"
    fi
    if [[ $(head -c 8 "$file" | od -An -tx1 | tr -d ' \n') != 89504e470d0a1a0a ]]; then
        rm -f "$file"
        die "The logo must be a PNG image."
    fi
    if [[ $(stat -c %s "$file") -gt 10485760 ]]; then
        rm -f "$file"
        die "The logo must be smaller than 10 MB."
    fi
    mkdir -p "$CONFIG_DIR"
    install -m 644 "$file" "$CUSTOM_LOGO"
    rm -f "$file"
}

# Describes the start-up screen.
boot_status_text() {
    local logo="the Works In All Things logo"
    [[ -f $CUSTOM_LOGO ]] && logo="your logo"
    if [[ $(get_setting QUIET_BOOT) != yes ]]; then
        echo "start-up text shown, then $logo while the browser starts"
    elif [[ -z $(boot_state METHOD) ]]; then
        echo "$logo while the browser starts (the start-up text can't be hidden on this computer)"
    else
        echo "quiet, with $logo"
    fi
}

# Hides the start-up text ("quiet": the logo on black until the page appears), shows it again ("normal"), or sets
# the logo ("logo <file or address>", or "logo default" for the Works In All Things logo).
cmd_boot() {
    case ${1:-} in
        "")
            boot_status_text
            ;;
        quiet | normal)
            require_root boot
            require_installed
            check_system
            if [[ $1 == quiet ]]; then
                set_setting QUIET_BOOT yes
            else
                set_setting QUIET_BOOT no
            fi
            apply_boot
            info "Start-up: $(boot_status_text). It takes effect at the next restart."
            ;;
        logo)
            require_root boot
            require_installed
            check_system
            [[ -n ${2:-} ]] || die "Use: kiosk boot logo <file.png or https address>, or: kiosk boot logo default"
            if [[ $2 == default ]]; then
                rm -f "$CUSTOM_LOGO"
            else
                set_boot_logo "$2"
            fi
            apply_boot
            info "Start-up: $(boot_status_text). It takes effect at the next restart."
            ;;
        *) die "Use: kiosk boot quiet|normal, or: kiosk boot logo <file.png or https address>|default" ;;
    esac
}

# Status ------------------------------------------------------------------------------------------------------

# Shows what the kiosk is doing.
cmd_status() {
    require_installed
    local state addresses restart_time resolution
    state=$(systemctl is-active kiosk.service 2>/dev/null || true)
    addresses=$(hostname -I 2>/dev/null || true)
    restart_time=$(get_setting RESTART_TIME)
    printf 'Kiosk %s on %s\n\n' "$KIOSK_VERSION" "$(. /etc/os-release && echo "$PRETTY_NAME")"
    printf '  %-18s %s\n' "Showing:" "$(get_setting URL)"
    printf '  %-18s %s\n' "Browser:" "$(systemctl is-active --quiet kiosk.service && echo running || echo "not running ($state)")"
    printf '  %-18s %s\n' "Browser type:" "$(get_setting BROWSER)"
    printf '  %-18s %s\n' "Screen:" "$(screen_schedule_text)"
    printf '  %-18s %s\n' "Rotation:" "$(get_setting ROTATION)"
    resolution=$(get_setting RESOLUTION)
    printf '  %-18s %s\n' "Resolution:" "${resolution:-auto}"
    printf '  %-18s %s\n' "Nightly restart:" "${restart_time:-off}"
    printf '  %-18s %s\n' "Start-up:" "$(boot_status_text)"
    printf '  %-18s %s\n' "VNC:" "$(vnc_status_text)"
    printf '  %-18s %s\n' "Time zone:" "$(timedatectl show --property=Timezone --value 2>/dev/null || echo unknown)"
    printf '  %-18s %s\n' "Host name:" "$(hostname)"
    printf '  %-18s %s\n' "IP addresses:" "${addresses:-none}"
    manage_status
    echo
    echo "Recent messages: ${SUDO_HINT}kiosk logs"
}

# Shows the kiosk's recent log messages.
cmd_logs() {
    journalctl -u kiosk.service -u kiosk-heartbeat.service -n "${1:-100}" --no-pager
}

# Updates -----------------------------------------------------------------------------------------------------

# Remembers where the installed files came from: a release tag or branch, and its commit. Nothing is saved for an
# install from a local copy.
save_source() {
    local ref=$1 commit=$2
    [[ -n $ref ]] || return 0
    mkdir -p "$CONFIG_DIR"
    {
        echo "# Works In All Things Kiosk: where the installed files came from. Written by the installer."
        printf 'REF=%q\n' "$ref"
        printf 'COMMIT=%q\n' "$commit"
    } >"$SOURCE_FILE"
}

# Prints REF or COMMIT from the installed-from file.
get_source() {
    [[ -r $SOURCE_FILE ]] || return 0
    (
        # shellcheck source=/dev/null
        . "$SOURCE_FILE"
        printf '%s' "${!1:-}"
    )
}

# Prints the tag of the latest Kiosk release, or nothing when none has been published.
latest_release() {
    curl -fsSL --max-time 20 "https://api.github.com/repos/$KIOSK_REPO/releases/latest" 2>/dev/null |
        sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' || true
}

# Prints the commit a tag or branch points to, or nothing when GitHub can't say.
ref_commit() {
    local commit
    commit=$(curl -fsSL --max-time 20 -H 'Accept: application/vnd.github.sha' \
        "https://api.github.com/repos/$KIOSK_REPO/commits/$1" 2>/dev/null || true)
    [[ $commit =~ ^[0-9a-f]{40}$ ]] && printf '%s' "$commit"
    return 0
}

# Updates Kiosk, keeping the settings: to the release, branch or tag given, or else to the latest release. Before
# the first release, a test build follows the branch it was installed from. Nothing is downloaded when the
# installed files are already that version.
cmd_update() {
    require_root update
    require_installed
    local ref=${1:-} commit dir url
    if [[ -z $ref ]]; then
        ref=$(latest_release)
        [[ -n $ref ]] || ref=$(get_source REF)
        [[ -n $ref ]] || die "No Kiosk release has been published yet, and this kiosk doesn't know where it was installed from. Give a branch or tag: ${SUDO_HINT}kiosk update <name>"
    fi
    commit=$(ref_commit "$ref")
    if [[ -n $commit && $commit == "$(get_source COMMIT)" ]]; then
        info "Kiosk is up to date ($KIOSK_VERSION from $ref)."
        return 0
    fi
    dir=$(mktemp -d)
    # shellcheck disable=SC2064 # The folder is known now and must be removed whatever happens later.
    trap "rm -rf '$dir'" EXIT
    info "Downloading Kiosk ($ref)"
    if [[ -n $commit ]]; then
        # The exact commit, so what's installed is what was checked.
        url="https://github.com/$KIOSK_REPO/archive/$commit.tar.gz"
        curl -fsSL "$url" | tar -xz --warning=no-timestamp -C "$dir" --strip-components 1 ||
            die "Couldn't download $ref."
    else
        # GitHub's API didn't answer: a release tag, or else a branch (branch names such as "feature/x" only work in
        # the long form).
        curl -fsSL "https://github.com/$KIOSK_REPO/archive/refs/tags/$ref.tar.gz" 2>/dev/null |
            tar -xz --warning=no-timestamp -C "$dir" --strip-components 1 2>/dev/null ||
            curl -fsSL "https://github.com/$KIOSK_REPO/archive/refs/heads/$ref.tar.gz" |
            tar -xz --warning=no-timestamp -C "$dir" --strip-components 1 ||
            die "Couldn't download $ref."
    fi
    bash "$dir/kiosk" install --update --source "$ref" --commit "$commit"
}

# Updates the Flathub browser, when the kiosk uses it. The browser picks it up at its next restart.
cmd_update_browser() {
    require_root update-browser
    [[ $(get_setting BROWSER) == flatpak ]] || return 0
    flatpak update --system --noninteractive -y "$FLATPAK_APP"
}

# VNC ---------------------------------------------------------------------------------------------------------

# Shows whether remote control is on and how to connect, turns it on (from the network, or only through an SSH
# tunnel) or off, or changes its password.
cmd_vnc() {
    case ${1:-} in
        "")
            require_installed
            printf 'VNC: %s\n' "$(vnc_status_text)"
            vnc_connect_hint
            ;;
        on | ssh-only)
            local allow_mac=no
            if [[ $1 == on && ${2:-} == --allow-mac ]]; then
                allow_mac=yes
            elif [[ -n ${2:-} ]]; then
                die "Use: kiosk vnc on [--allow-mac], or: kiosk vnc ssh-only"
            fi
            require_root vnc
            require_installed
            install_vnc
            [[ -s $VNC_DIR/password ]] || ask_vnc_password
            set_setting VNC "$1"
            set_setting VNC_ALLOW_MAC "$allow_mac"
            write_vnc_config
            if [[ $1 == on ]]; then
                open_vnc_firewall
            else
                close_vnc_firewall
            fi
            systemctl restart kiosk.service
            info "VNC is $(vnc_status_text)."
            vnc_connect_hint
            ;;
        off)
            [[ -z ${2:-} ]] || die "Use: kiosk vnc off"
            require_root vnc
            require_installed
            set_setting VNC off
            close_vnc_firewall
            systemctl restart kiosk.service
            info "VNC is off."
            ;;
        password)
            require_root vnc
            require_installed
            [[ -d $VNC_DIR ]] || die "Turn VNC on first: ${SUDO_HINT}kiosk vnc on"
            can_ask || die "Run this in a terminal, where it can ask for the new password."
            ask_vnc_password
            write_vnc_config
            [[ $(get_setting VNC) =~ ^(on|ssh-only)$ ]] && systemctl restart kiosk.service
            info "The VNC password is changed."
            ;;
        *) die "Use: kiosk vnc on [--allow-mac]|ssh-only|off|password" ;;
    esac
}

# Describes the VNC setting in a few words.
vnc_status_text() {
    case $(get_setting VNC) in
        on)
            printf 'on (port %s, user name kiosk' "$VNC_PORT"
            [[ $(get_setting VNC_ALLOW_MAC) == yes ]] && printf '; Mac Screen Sharing allowed, unencrypted picture'
            printf ')'
            ;;
        ssh-only) printf 'on, through an SSH tunnel only' ;;
        *) printf 'off' ;;
    esac
}

# Says how to connect a VNC viewer, when VNC is on.
vnc_connect_hint() {
    local address
    address=$(hostname -I 2>/dev/null | awk '{ print $1 }')
    address=${address:-<this computer>}
    case $(get_setting VNC) in
        on)
            echo "Connect a VNC viewer (such as TigerVNC or RealVNC Viewer) to $address:$VNC_PORT, with the user name"
            echo "kiosk and the VNC password. The viewer asks you to trust this kiosk's certificate the first time."
            if [[ $(get_setting VNC_ALLOW_MAC) == yes ]]; then
                echo "On a Mac, Screen Sharing works too: vnc://$address (its picture and typing aren't encrypted)."
            fi
            ;;
        ssh-only)
            echo "On your computer: ssh -L 5901:localhost:$VNC_PORT <you>@$address"
            echo "Then connect a VNC viewer to localhost:5901 (on a Mac, Screen Sharing works: vnc://localhost:5901),"
            echo "with the user name kiosk and the VNC password."
            ;;
    esac
}

# Installs wayvnc (and openssl for its keys), and makes the folder for its settings and keys. Safe to run again:
# the keys are made once.
install_vnc() {
    if ! command -v wayvnc >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1; then
        detect_distro
        [[ ${KIOSK_LISTS_REFRESHED:-no} == yes ]] || quietly pkg_refresh || true
        pkg_install wayvnc openssl
    fi
    mkdir -p "$VNC_DIR"
    chown "root:$KIOSK_USER" "$VNC_DIR"
    chmod 750 "$VNC_DIR"
    if [[ ! -s $VNC_DIR/tls_key.pem || ! -s $VNC_DIR/tls_cert.pem ]]; then
        quietly openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -sha384 -days 3650 -nodes \
            -keyout "$VNC_DIR/tls_key.pem" -out "$VNC_DIR/tls_cert.pem" -subj "/CN=$(hostname)" \
            -addext "subjectAltName=DNS:$(hostname),DNS:localhost,IP:127.0.0.1" ||
            die "Couldn't make the VNC encryption key."
    fi
    if [[ ! -s $VNC_DIR/rsa_key.pem ]]; then
        # wayvnc reads the older (PKCS#1) form; OpenSSL 3 makes it only when asked.
        quietly openssl genrsa -traditional -out "$VNC_DIR/rsa_key.pem" 2048 ||
            quietly openssl genrsa -out "$VNC_DIR/rsa_key.pem" 2048 ||
            die "Couldn't make the VNC encryption key."
    fi
    chown "root:$KIOSK_USER" "$VNC_DIR"/*.pem
    chmod 640 "$VNC_DIR"/*.pem
}

# Asks for a new VNC password (twice, without showing it) and saves it. With no one to ask, it makes one and
# shows it.
ask_vnc_password() {
    local first second
    if ! can_ask; then
        first=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 12)
        info "VNC password: $first (change it with: ${SUDO_HINT}kiosk vnc password)"
    else
        while true; do
            read -r -s -p "VNC password (8 or more characters): " first </dev/tty || true
            echo >&2
            if ((${#first} < 8)); then
                warn "The password must have 8 or more characters."
                continue
            fi
            read -r -s -p "The same password again: " second </dev/tty || true
            echo >&2
            [[ $first == "$second" ]] && break
            warn "The passwords didn't match."
        done
    fi
    mkdir -p "$VNC_DIR"
    (umask 077 && printf '%s\n' "$first" >"$VNC_DIR/password")
}

# Writes wayvnc's settings from the VNC setting and the saved password. It always asks for the password and
# encrypts the connection: TLS (TigerVNC and other VeNCrypt viewers) or RSA-AES (RealVNC Viewer and others).
# Through an SSH tunnel (ssh-only), SSH already encrypts it, so the Mac's Screen Sharing may sign in too, with
# Apple's own method (it protects the password but not the picture). "kiosk vnc on --allow-mac" allows that
# method from the network as well, for those who accept an unencrypted picture.
write_vnc_config() {
    local address=0.0.0.0 version
    [[ $(get_setting VNC) == ssh-only ]] && address=127.0.0.1
    version=$(wayvnc --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -n 1)
    {
        echo "# Works In All Things Kiosk: written by \"kiosk vnc\"; change VNC with the kiosk command, not here."
        echo "use_relative_paths=true"
        echo "address=$address"
        echo "port=$VNC_PORT"
        echo "enable_auth=true"
        echo "username=kiosk"
        echo "password=$(head -n 1 "$VNC_DIR/password")"
        echo "private_key_file=tls_key.pem"
        echo "certificate_file=tls_cert.pem"
        # RSA-AES arrived in wayvnc 0.7; older versions offer TLS only.
        if [[ $version =~ ^([0-9]+)\.([0-9]+)$ ]] &&
            ((BASH_REMATCH[1] > 0 || BASH_REMATCH[2] >= 7)); then
            echo "rsa_private_key_file=rsa_key.pem"
            if [[ $address == 127.0.0.1 || $(get_setting VNC_ALLOW_MAC) == yes ]]; then
                echo "relax_encryption=true"
            fi
        fi
    } >"$VNC_DIR/config.new"
    chown "root:$KIOSK_USER" "$VNC_DIR/config.new"
    chmod 640 "$VNC_DIR/config.new"
    mv "$VNC_DIR/config.new" "$VNC_DIR/config"
}

# Opens the VNC port in the firewall when one is on (firewalld, as on Fedora, or ufw), and notes it so off and
# uninstall close it again. A port someone else opened is left alone.
open_vnc_firewall() {
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
        firewall-cmd --permanent --query-service=vnc-server >/dev/null 2>&1 && return 0
        quietly firewall-cmd --permanent --add-service=vnc-server && quietly firewall-cmd --reload &&
            echo firewalld >"$VNC_DIR/firewall"
    elif command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
        ufw status 2>/dev/null | grep -qE "^$VNC_PORT/tcp +ALLOW" && return 0
        quietly ufw allow "$VNC_PORT/tcp" && echo ufw >"$VNC_DIR/firewall"
    fi
    return 0
}

# Closes the VNC port in the firewall, if Kiosk opened it.
close_vnc_firewall() {
    case $(cat "$VNC_DIR/firewall" 2>/dev/null) in
        firewalld)
            quietly firewall-cmd --permanent --remove-service=vnc-server || true
            quietly firewall-cmd --reload || true
            ;;
        ufw) quietly ufw delete allow "$VNC_PORT/tcp" || true ;;
    esac
    rm -f "$VNC_DIR/firewall"
}

# Uninstall ---------------------------------------------------------------------------------------------------

# Removes everything Kiosk added and puts the computer back as it was. Packages are left installed, because
# other things may use them.
cmd_uninstall() {
    [[ ${1:-} == --yes || ${1:-} == -y ]] && ASSUME_YES=yes
    require_root uninstall
    confirm "Remove Kiosk and its settings from this computer?" y || die "Nothing was changed."

    info "Removing Kiosk"
    local name display_manager getty
    for name in kiosk.service kiosk-update.timer kiosk-screen-off.timer kiosk-screen-on.timer kiosk-reboot.timer \
        kiosk-heartbeat.timer; do
        systemctl disable --now "$name" >/dev/null 2>&1 || true
    done
    for name in kiosk.service kiosk-screen-off.service kiosk-screen-on.service kiosk-reboot.service \
        kiosk-update.service kiosk-update.timer kiosk-screen-off.timer kiosk-screen-on.timer kiosk-reboot.timer \
        kiosk-heartbeat.service kiosk-heartbeat.timer; do
        rm -f "$UNIT_DIR/$name"
    done
    systemctl daemon-reload
    blank_screen 0
    boot_quiet_off
    remove_browser_policy
    close_vnc_firewall

    display_manager=$(recall DISPLAY_MANAGER)
    getty=$(recall GETTY_TTY1)
    [[ $getty == disabled ]] || systemctl enable --now getty@tty1.service >/dev/null 2>&1 || true
    if [[ -n $display_manager ]]; then
        systemctl enable "$display_manager" >/dev/null 2>&1 || warn "Couldn't turn $display_manager back on."
    fi

    if id "$KIOSK_USER" >/dev/null 2>&1; then
        # Ends the kiosk user's session (its sound and session bus) so the user can be removed.
        loginctl terminate-user "$KIOSK_USER" >/dev/null 2>&1 || true
        local seconds=0
        while pgrep -u "$KIOSK_USER" >/dev/null && ((seconds < 10)); do
            sleep 1
            seconds=$((seconds + 1))
        done
        pkill -KILL -u "$KIOSK_USER" >/dev/null 2>&1 || true
        userdel "$KIOSK_USER" || warn "Couldn't remove the $KIOSK_USER user."
    fi
    rm -rf "$KIOSK_HOME" "$CONFIG_DIR" /etc/pam.d/kiosk "$COMMAND_LINK" "$INSTALL_DIR" "$INSTALL_LOG" \
        "$SCREEN_OFF_FLAG" "$LOCK_FILE"

    info "Kiosk is removed. The packages it installed (such as cage and Chromium) are still there."
    [[ -z $display_manager ]] || echo "The desktop ($display_manager) starts again after a restart."
}

# Help --------------------------------------------------------------------------------------------------------

# Prints one command and what it does, in two columns; a long command puts its description on the next line.
help_line() {
    if [[ ${#1} -gt 35 ]]; then
        printf '  %s\n  %-35s %s\n' "$1" "" "$2"
    else
        printf '  %-35s %s\n' "$1" "$2"
    fi
}

# Shows the commands.
cmd_help() {
    local s=$SUDO_HINT
    echo "Works In All Things Kiosk $KIOSK_VERSION: shows one web address full screen, from power-on."
    echo
    help_line "${s}kiosk install" "Install, or change the settings (asks questions)"
    help_line "kiosk url" "Show the address"
    help_line "${s}kiosk url <address>" "Show a different address"
    help_line "${s}kiosk rotate 0|90|180|270" "Turn the picture for portrait or upside-down screens"
    help_line "${s}kiosk resolution 1920x1080|auto" "Set the screen resolution (auto: the screen's own best)"
    help_line "${s}kiosk screen off|on" "Turn the screen off or on now"
    help_line "${s}kiosk screen schedule HH:MM HH:MM" "Turn the screen off and on at these times each day"
    help_line "${s}kiosk screen schedule off" "Keep the screen on"
    help_line "${s}kiosk restart-time HH:MM|off" "Restart the computer at this time each day"
    help_line "${s}kiosk restart" "Restart the browser"
    help_line "${s}kiosk boot quiet|normal" "Hide the start-up text, or show it again"
    help_line "${s}kiosk boot logo <file.png>|default" "Your logo at start-up (or an https address); default: ours"
    help_line "kiosk vnc" "Show whether remote control (VNC) is on, and how to connect"
    help_line "${s}kiosk vnc on|off" "Allow control of the screen from the network over VNC, or stop it"
    help_line "${s}kiosk vnc on --allow-mac" "Also allow the Mac's Screen Sharing (its picture isn't encrypted)"
    help_line "${s}kiosk vnc ssh-only" "Allow VNC only through an SSH tunnel"
    help_line "${s}kiosk vnc password" "Change the VNC password"
    help_line "kiosk status" "Show what the kiosk is doing"
    help_line "${s}kiosk logs" "Show recent messages"
    help_line "${s}kiosk update [branch or tag]" "Update Kiosk to the latest release (or a branch or tag)"
    help_line "${s}kiosk manage <rock address> <code>" "Let Rock manage this kiosk (Kiosk Manager plugin)"
    help_line "${s}kiosk unmanage" "Stop Rock managing this kiosk"
    help_line "${s}kiosk uninstall" "Remove Kiosk"
    [[ -n $s ]] || echo "  (This computer has no sudo: run the commands as root, after su -.)"
    cat <<EOF

Install options (for installing without questions):
  --url <address>                     --timezone <central, America/Chicago...>
  --rotation 0|90|180|270             --resolution 1920x1080|auto
  --screen-off HH:MM --screen-on HH:MM
  --restart-time HH:MM|off            --browser auto|native|flatpak
  --quiet-boot yes|no (hide the start-up text; yes unless you say no)
  --yes (no questions)                --reboot (restart when done)
  --manage <rock address> --code <code>
                                      Managed by Rock: its settings come from the kiosk's page in Rock
  --allow-http                        Allow an http:// Rock address (test servers only)

Help and support: https://worksinallthings.com/kiosk/
EOF
}

# True when a command changes something, so it takes the kiosk lock first. Showing settings and the kiosk
# service's own "screen check" don't, so they never wait.
is_locking_command() {
    case $1 in
        install | rotate | resolution | restart-time | restart | update | uninstall | manage | unmanage) return 0 ;;
        boot) [[ -n ${2:-} ]] ;;
        url | vnc) [[ -n ${2:-} ]] ;;
        screen) [[ ${2:-} != check ]] ;;
        *) return 1 ;;
    esac
}

main() {
    local command=${1:-help}
    [[ $# -gt 0 ]] && shift
    if [[ $EUID -eq 0 ]] && is_locking_command "$command" "${1:-}"; then
        take_lock || die "Another kiosk command is running (or Rock is updating this kiosk). Try again in a minute."
    fi
    case $command in
        install) cmd_install "$@" ;;
        url) cmd_url "$@" ;;
        rotate) cmd_rotate "$@" ;;
        resolution) cmd_resolution "$@" ;;
        screen) cmd_screen "$@" ;;
        restart-time) cmd_restart_time "$@" ;;
        restart) cmd_restart ;;
        boot) cmd_boot "$@" ;;
        vnc) cmd_vnc "$@" ;;
        status) cmd_status ;;
        logs) cmd_logs "$@" ;;
        update) cmd_update "$@" ;;
        update-browser) cmd_update_browser ;;
        manage) cmd_manage "$@" ;;
        unmanage) cmd_unmanage ;;
        heartbeat) cmd_heartbeat ;;
        browser-policy)
            # Used by kiosk.service before the browser starts; not for people.
            require_root browser-policy
            write_browser_policy
            ;;
        uninstall) cmd_uninstall "$@" ;;
        version | --version) echo "$KIOSK_VERSION" ;;
        help | --help | -h) cmd_help ;;
        *) die "Unknown command: $command (see: kiosk help)" ;;
    esac
}

main "$@"
